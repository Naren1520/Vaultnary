# Database
DATABASE_URL=postgres://vaultnary:changeme@localhost:5432/vaultnary

# Redis
REDIS_URL=redis://localhost:6379

# API server
PORT=8080
SESSION_SECRET=replace-with-a-64-byte-random-hex-string
LOG_FORMAT=human
APP_ENV=development

# SMTP (email sending)
# Leave blank to skip sending - tokens will be logged via tracing instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Frontend
VITE_API_BASE_URL=http://localhost:8080
